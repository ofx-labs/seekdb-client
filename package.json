{
  "name": "seekdb-client",
  "displayName": "seekdb-client",
  "description": "seekdb-client is an extension toolkit built _for personal developers_, delivering powerful database management and development workflows. Deeply integrated with the **seekdb** database system—and fully compatible with **MySQL**—it unifies database operations under one intuitive interface.",
  "publisher": "alfredlau",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofx-labs/seekdb-client"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/logo.png",
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "configuration": {
      "title": "seekdb-client",
      "properties": {
        "seekdb.updateNotification.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用版本更新通知"
        },
        "seekdb.database.embedding.huggingFaceMirror": {
          "type": "string",
          "enum": [
            "china",
            "international"
          ],
          "default": "china",
          "description": "HuggingFace mirror URL"
        },
        "seekdb.preflight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用启动时的环境预检查"
        },
        "seekdb.preflight.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "显示预检查进度通知"
        },
        "seekdb.preflight.checkDocker": {
          "type": "boolean",
          "default": true,
          "description": "检查 Docker 环境是否可用"
        },
        "seekdb.preflight.checkSeekDBImage": {
          "type": "boolean",
          "default": true,
          "description": "检查 SeekDB Docker 镜像是否存在"
        },
        "seekdb.preflight.checkSeekDBInstance": {
          "type": "boolean",
          "default": true,
          "description": "检查 SeekDB 实例是否运行"
        }
      }
    },
    "commands": [
      {
        "command": "seekdb.showUpdateLog",
        "title": "查看更新日志",
        "icon": "$(info)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openDatabase",
        "title": "New Connection",
        "icon": "$(plus)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openDocs",
        "title": "Open Documentation",
        "icon": "$(book)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openSettings",
        "title": "Open Settings",
        "icon": "$(settings-gear)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.runPreflight",
        "title": "运行环境检查",
        "icon": "$(checklist)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.showPreflightReport",
        "title": "查看环境检查报告",
        "icon": "$(output)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.selectDatabase",
        "title": "Select Database",
        "category": "seekdb"
      },
      {
        "command": "seekdb.connectDatabase",
        "title": "Connect",
        "icon": "$(play)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.disconnectDatabase",
        "title": "Disconnect",
        "icon": "$(stop)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.deleteConnection",
        "title": "Delete Connection",
        "icon": "$(trash)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openCollectionBrowser",
        "title": "Open Collection Browser",
        "icon": "$(list-unordered)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.refreshConnections",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openConnectionCollections",
        "title": "View Collections",
        "icon": "$(list-unordered)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.signInCloud",
        "title": "Sign in to OceanBase Cloud",
        "icon": "$(sign-in)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.createAppFromTemplate",
        "title": "Create App from Template",
        "icon": "$(plus)",
        "category": "seekdb"
      },
      {
        "command": "seekdb.openTemplate",
        "title": "Open Template",
        "icon": "$(link-external)",
        "category": "seekdb"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "seekdb.openDatabase",
          "when": "view == seekdb.cloudConnections || view == seekdb.localConnections",
          "group": "navigation@1"
        },
        {
          "command": "seekdb.refreshConnections",
          "when": "view == seekdb.cloudConnections || view == seekdb.localConnections",
          "group": "navigation@2"
        },
        {
          "command": "seekdb.createAppFromTemplate",
          "when": "view == seekdb.apps",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "seekdb.connectDatabase",
          "when": "(view == seekdb.cloudConnections || view == seekdb.localConnections) && viewItem == connection-disconnected",
          "group": "inline@1"
        },
        {
          "command": "seekdb.disconnectDatabase",
          "when": "(view == seekdb.cloudConnections || view == seekdb.localConnections) && viewItem == connection-connected",
          "group": "inline@1"
        },
        {
          "command": "seekdb.openConnectionCollections",
          "when": "(view == seekdb.cloudConnections || view == seekdb.localConnections) && viewItem == connection-connected",
          "group": "inline@2"
        },
        {
          "command": "seekdb.deleteConnection",
          "when": "(view == seekdb.cloudConnections || view == seekdb.localConnections) && (viewItem == connection-connected || viewItem == connection-disconnected)",
          "group": "inline@3"
        }
      ]
    },
    "views": {
      "seekdb": [
        {
          "id": "seekdb.cloudConnections",
          "name": "SEEKDB (CLOUD)",
          "type": "tree"
        },
        {
          "id": "seekdb.localConnections",
          "name": "SEEKDB (LOCAL)",
          "type": "tree"
        },
        {
          "id": "seekdb.apps",
          "name": "App",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "seekdb.cloudConnections",
        "contents": "Connect to OceanBase Cloud\n\nManage your SeekDB databases directly from your editor.\n\n[Sign in to get started](command:seekdb.signInCloud)\n\nLearn more about SeekDB [here](https://en.oceanbase.com/).",
        "when": "seekdb.cloudConnectionsEmpty"
      },
      {
        "view": "seekdb.localConnections",
        "contents": "No local connections\n\nCreate a connection to your local SeekDB instance.\n\n[Create Connection](command:seekdb.openDatabase)",
        "when": "seekdb.localConnectionsEmpty"
      },
      {
        "view": "seekdb.apps",
        "contents": "Create a new application\n\nStart building your SeekDB application from a template.\n\n[Create App from Template](command:seekdb.createAppFromTemplate)",
        "when": "seekdb.appsEmpty"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seekdb",
          "title": "seekdb",
          "icon": "media/dep.png"
        }
      ]
    },
    "keybindings": []
  },
  "scripts": {
    "install:all": "npm install && cd ui && npm install",
    "postinstall": "node scripts/ensure-model.js || echo 'Model setup will run on first use'",
    "setup-model": "bash scripts/setup-model.sh",
    "test-model": "node scripts/test-model.js",
    "webview:dev": "cd ui && npm run start",
    "webview:watch": "cd ui && npm run watch",
    "webview:build": "cd ui && npm run build",
    "vscode:prepublish": "npm run webview:build && npm run compile",
    "vscode:package": "npx vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "dev": "npm run webview:build && npm run compile && code --extensionDevelopmentPath=$PWD ./"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/mysql": "^2.15.27",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "undici-types": "^7.10.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "fs-extra": "^11.3.0",
    "mysql2": "^3.15.3",
    "seekdb": "^1.1.1"
  }
}
